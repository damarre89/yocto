[Unit]
Description=Checklist repo watcher
ConditionPathExists=/usr/local/bin/checklist-repo-watcher
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/checklist-repo-watcher
Restart=on-failure
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
DynamicUser=no

[Install]
WantedBy=multi-user.target
